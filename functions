#!/usr/bin/env bash
KEYCLOAK_PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$KEYCLOAK_PLUGIN_ROOT/config"
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"
source "$PLUGIN_CORE_AVAILABLE_PATH/common/property-functions"
set -eo pipefail
# make failures inside $(...) abort too, not just in the calling shell
shopt -s inherit_errexit
[[ $DOKKU_TRACE ]] && set -x

fn-keycloak-exists() {
  declare desc="returns 0 when the app is a Keycloak instance managed by this plugin"
  declare APP="$1"
  fn-plugin-property-exists "$KEYCLOAK_PLUGIN_NAME" "$APP" "version"
}

fn-keycloak-has-config-key() {
  declare desc="returns 0 when the app has the config key set"
  declare APP="$1" KEY="$2"
  local keys
  # captured first: piping into grep -q under pipefail fails at random when
  # grep exits early and the writer gets SIGPIPE
  keys="$(dokku config:keys "$APP")"
  grep -qxF -- "$KEY" <<<"$keys"
}

fn-keycloak-get() {
  declare desc="reads a plugin property for an instance"
  declare APP="$1" KEY="$2" DEFAULT="$3"
  fn-plugin-property-get "$KEYCLOAK_PLUGIN_NAME" "$APP" "$KEY" "$DEFAULT"
}

fn-keycloak-set() {
  declare desc="writes a plugin property for an instance"
  declare APP="$1" KEY="$2" VALUE="$3"
  fn-plugin-property-write "$KEYCLOAK_PLUGIN_NAME" "$APP" "$KEY" "$VALUE"
}

verify_keycloak_name() {
  declare desc="fails unless the name is valid and belongs to an existing instance"
  declare APP="$1"

  [[ -n "$APP" ]] || dokku_log_fail "Please specify a Keycloak instance name"
  is_valid_app_name "$APP"
  fn-keycloak-exists "$APP" || DOKKU_FAIL_EXIT_CODE=20 dokku_log_fail "Keycloak instance $APP does not exist"
}

fn-keycloak-plugin-install-hint() {
  declare desc="prints the command that installs a required plugin"
  declare PLUGIN="$1"
  echo "sudo dokku plugin:install https://github.com/dokku/dokku-${PLUGIN}.git ${PLUGIN}"
}

fn-keycloak-missing-plugins() {
  declare desc="lists required plugins that are not enabled, with install hints"
  local plugin
  for plugin in postgres letsencrypt; do
    [[ -d "$PLUGIN_ENABLED_PATH/$plugin" ]] || echo "$plugin ($(fn-keycloak-plugin-install-hint "$plugin"))"
  done
}

fn-keycloak-require-plugin() {
  declare desc="fails with an install hint unless the given plugin is enabled"
  declare PLUGIN="$1"
  [[ -d "$PLUGIN_ENABLED_PATH/$PLUGIN" ]] || dokku_log_fail "The $PLUGIN plugin is required. Install it with: $(fn-keycloak-plugin-install-hint "$PLUGIN")"
}

fn-keycloak-validate-version() {
  declare desc="fails unless the tag is safe to use and new enough"
  declare VERSION="$1"

  [[ "$VERSION" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || dokku_log_fail "Invalid Keycloak version: $VERSION"
  # bootstrap admin variables and the management port need Keycloak 26
  if [[ "$VERSION" =~ ^([0-9]+)\. ]] && [[ "${BASH_REMATCH[1]}" -lt 26 ]]; then
    dokku_log_fail "Keycloak $VERSION is not supported; use 26.0.0 or newer"
  fi
}

fn-keycloak-is-build-option() {
  declare desc="returns 0 when a config key must be applied with kc.sh build"
  declare KEY="$1"
  local pattern
  for pattern in $KEYCLOAK_BUILD_OPTIONS; do
    # shellcheck disable=SC2053 # the pattern is a glob on purpose
    [[ "$KEY" == $pattern ]] && return 0
  done
  return 1
}

fn-keycloak-build-env() {
  declare desc="prints the instance's build-time options as a sourceable file"
  declare APP="$1"
  local key
  for key in $(dokku config:keys "$APP" 2>/dev/null); do
    fn-keycloak-is-build-option "$key" || continue
    printf '%s=%q\n' "$key" "$(dokku config:get "$APP" "$key")"
  done
}

fn-keycloak-providers-dir() {
  declare desc="prints the directory holding an instance's extension jars"
  declare APP="$1"
  echo "$KEYCLOAK_DATA_ROOT/$APP/providers"
}

fn-keycloak-providers() {
  declare desc="prints the paths of an instance's extension jars, sorted"
  declare APP="$1"
  local jar
  for jar in "$(fn-keycloak-providers-dir "$APP")"/*.jar; do
    [[ -f "$jar" ]] && echo "$jar"
  done
  return 0
}

fn-keycloak-validate-provider-name() {
  declare desc="fails unless the name is a plain jar file name"
  declare NAME="$1"
  [[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.jar$ ]] || dokku_log_fail "Invalid provider file name: $NAME (use letters, digits, dots, dashes and underscores, ending in .jar)"
}

fn-keycloak-build-hash() {
  declare desc="prints a hash of everything that goes into an instance's image"
  declare APP="$1"
  local jar
  {
    echo "$KEYCLOAK_IMAGE_REPO:$(fn-keycloak-get "$APP" version)"
    fn-keycloak-build-env "$APP"
    cat "$KEYCLOAK_PLUGIN_ROOT/image/"*
    # adds nothing without providers, so those instances keep their hash
    while IFS= read -r jar; do
      echo "provider ${jar##*/} $(sha256sum <"$jar" | cut -d' ' -f1)"
    done < <(fn-keycloak-providers "$APP")
  } | sha256sum | cut -d' ' -f1
}

fn-keycloak-build-image() {
  declare desc="builds the optimized Keycloak image for an instance and tags it"
  declare APP="$1" TAG="$2"
  local version context jar

  version="$(fn-keycloak-get "$APP" version)"
  context="$(mktemp -d)"
  cp "$KEYCLOAK_PLUGIN_ROOT/image/"* "$context/"
  fn-keycloak-build-env "$APP" >"$context/build.env"
  mkdir "$context/providers"
  while IFS= read -r jar; do
    cp "$jar" "$context/providers/"
  done < <(fn-keycloak-providers "$APP")

  dokku_log_info1 "Building Keycloak $version image"
  if ! "$DOCKER_BIN" image build --quiet --tag "$TAG" --build-arg "KEYCLOAK_IMAGE=$KEYCLOAK_IMAGE_REPO:$version" "$context" >/dev/null; then
    rm -rf "$context"
    dokku_log_fail "Failed to build the Keycloak image for $APP"
  fi
  rm -rf "$context"
}

fn-keycloak-prune-images() {
  declare desc="removes build tags for an instance other than the one given"
  declare APP="$1" KEEP="$2"
  local tag
  for tag in $("$DOCKER_BIN" image ls "dokku-keycloak/$APP" --format '{{.Repository}}:{{.Tag}}'); do
    [[ "$tag" == "$KEEP" ]] || "$DOCKER_BIN" image rm "$tag" >/dev/null 2>&1 || true
  done
}

fn-keycloak-drop-db-link() {
  declare desc="removes the docker link to the instance database, if anything added one"
  declare APP="$1"
  local database link_option docker_options

  # postgres:link adds a docker link, and so would a re-link or a future
  # dokku-postgres. The database is not on the default bridge, so with the
  # link the next container fails to start; it resolves by the same name on
  # the private network instead. The link record (DATABASE_URL,
  # postgres:links, destroy protection) is kept.
  database="$(fn-keycloak-get "$APP" database)"
  link_option="--link dokku.postgres.$database:dokku-postgres-$database"
  # captured first, see fn-keycloak-has-config-key
  docker_options="$(dokku docker-options:report "$APP")"
  [[ "$docker_options" == *"$link_option"* ]] || return 0
  # instances from before the private network still rely on the link
  [[ -n "$(fn-keycloak-get "$APP" network)" ]] || return 0
  dokku docker-options:remove "$APP" build,deploy,run "$link_option" >/dev/null
}

fn-keycloak-apply() {
  declare desc="rebuilds and deploys an instance if its build inputs changed, otherwise restarts it"
  declare APP="$1"
  local build_hash tag

  # Runtime-only changes cost a restart; version or build-time option
  # changes a rebuild and a healthchecked deploy.
  # Explicit returns: callers may run this where errexit is suspended.
  fn-keycloak-drop-db-link "$APP" || return 1
  build_hash="$(fn-keycloak-build-hash "$APP")" || return 1
  if [[ "$build_hash" == "$(fn-keycloak-get "$APP" build-hash)" ]]; then
    dokku ps:restart "$APP" || return 1
    return 0
  fi

  # A fresh tag per attempt: git:from-image skips images it has seen before,
  # which would turn the retry of a deploy that failed its healthcheck into
  # a silent no-op.
  tag="dokku-keycloak/$APP:$(fn-keycloak-get "$APP" version)-$(date +%s)"
  fn-keycloak-build-image "$APP" "$tag" || return 1
  dokku git:from-image "$APP" "$tag" || return 1
  fn-keycloak-set "$APP" build-hash "$build_hash"
  fn-keycloak-prune-images "$APP" "$tag"
}

fn-keycloak-cleanup() {
  declare desc="removes plugin state, extension jars and build images for an instance"
  declare APP="$1"
  fn-plugin-property-destroy "$KEYCLOAK_PLUGIN_NAME" "$APP"
  # pre-upgrade backups next to it are kept on purpose
  rm -rf "$(fn-keycloak-providers-dir "$APP")"
  fn-keycloak-prune-images "$APP" ""
}

fn-keycloak-validate-key() {
  declare desc="fails unless the key is a Keycloak or JVM setting this plugin may change"
  declare KEY="$1"
  [[ "$KEY" =~ ^(KC_[A-Z0-9_]+|JAVA_OPTS[A-Z0-9_]*)$ ]] || dokku_log_fail "Invalid key $KEY: only KC_* and JAVA_OPTS* settings are managed here (use dokku config:set for anything else)"
  [[ "$KEY" != "KC_DB" ]] || dokku_log_fail "KC_DB cannot be changed: instances are built for the linked PostgreSQL database"
}

fn-keycloak-apply-config() {
  declare desc="applies changed settings unless the caller asked not to restart"
  declare APP="$1" NO_RESTART="$2"

  if [[ "$NO_RESTART" == "true" ]]; then
    dokku_log_info1 "Skipping restart; run 'dokku keycloak:restart $APP' to apply"
    return 0
  fi
  fn-keycloak-apply "$APP"
}

fn-keycloak-oneoff() {
  declare desc="runs a bash script in a throwaway container of the instance, with stdin attached"
  declare APP="$1" SCRIPT="$2"
  shift 2
  local container status=0

  # dokku run only attaches stdin when there is a TTY, so a detached
  # container (same image, env and database link) is driven via docker exec.
  # It sleeps rather than exits so it outlives the exec, and its own timeout
  # bounds its life even if the trap below never runs.
  container="$(dokku run:detached "$APP" /bin/sleep 3600 2>/dev/null | tail -n1)"
  [[ -n "$container" ]] || dokku_log_fail "Could not start a one-off container for $APP"
  # shellcheck disable=SC2064 # the name is fixed now, on purpose
  trap "'$DOCKER_BIN' container rm -f '$container' >/dev/null 2>&1 || true" EXIT INT TERM

  # The entrypoint maps DATABASE_URL to KC_DB_*. KC_CACHE=local keeps the
  # one-off Keycloak from joining the running node's cluster.
  "$DOCKER_BIN" container exec -i --env KC_CACHE=local "$container" \
    /opt/keycloak/bin/dokku-entrypoint.sh /bin/bash -c "$SCRIPT" keycloak "$@" || status=$?
  "$DOCKER_BIN" container rm -f "$container" >/dev/null 2>&1 || true
  trap - EXIT INT TERM
  return "$status"
}

fn-keycloak-validate-realm() {
  declare desc="fails unless the realm name is safe to pass to kc.sh"
  declare REALM="$1"
  [[ "$REALM" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || dokku_log_fail "Invalid realm name: $REALM"
}
