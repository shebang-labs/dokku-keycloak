#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

cmd-keycloak-help() {
  declare desc="help command"
  declare CMD="$1"
  local plugin_name="keycloak"
  local plugin_description="Manage Keycloak instances backed by PostgreSQL"

  if [[ "$CMD" == "${plugin_name}:help" ]] || [[ "$CMD" == "$plugin_name" ]]; then
    echo "Usage: dokku ${plugin_name}[:COMMAND]"
    echo ''
    echo "$plugin_description"
    echo ''
    echo 'Additional commands:'
    fn-keycloak-help-content | sort | column -c2 -t -s,
  elif [[ $(ps -o command= $PPID) == *"--all"* ]]; then
    fn-keycloak-help-content
  else
    echo "    $plugin_name, $plugin_description"
  fi
}

fn-keycloak-help-content() {
  declare desc="return help content"
  cat <<help_content
    keycloak:admin-credentials <name>, Print the bootstrap admin username and password
    keycloak:config:get <name> <KEY>, Print one Keycloak setting
    keycloak:config:set <name> KEY=VALUE... [--no-restart], Set Keycloak settings (KC_* and JAVA_OPTS*) and apply them
    keycloak:config:unset <name> KEY... [--no-restart], Remove Keycloak settings and apply the change
    keycloak:create <name> [--version <tag>] [--memory <limit>], Create a Keycloak instance with its own PostgreSQL database
    keycloak:destroy <name> [--force], Destroy a Keycloak instance and its database
    keycloak:domains:set <name> <domain> [<domain>...], Set the domains of an instance and pin Keycloak's hostname to the first
    keycloak:export <name> [<realm>], Export one realm (or all) as JSON on stdout
    keycloak:import <name> <file|-> [--override], Import realms from a JSON export and restart
    keycloak:info <name>, Show details about a Keycloak instance
    keycloak:letsencrypt <name> [--email <email>] [--force], Enable Let's Encrypt TLS (--force replaces a still-valid certificate)
    keycloak:list, List Keycloak instances
    keycloak:providers:add <name> <https-url|path> --sha256 <hex> [--no-restart], Install an extension jar after verifying its checksum and rebuild
    keycloak:providers:list <name>, List installed extension jars with their size and SHA-256
    keycloak:providers:remove <name> <jar> [--no-restart], Remove an extension jar and rebuild
    keycloak:logs <name> [-t] [-n <lines>], Show the logs of a Keycloak instance
    keycloak:restart <name>, Restart an instance (rebuilding if build-time options changed)
    keycloak:upgrade <name> [--version <tag>] [--force], Back up the database and move an instance to another Keycloak release
    keycloak:start <name>, Start a stopped Keycloak instance
    keycloak:stop <name>, Stop a running Keycloak instance
help_content
}
